# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 110

[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

[*.html]
indent_style = space
indent_size = 2
tab_width = 2

[*.css]
indent_style = space
indent_size = 4
tab_width = 4
