#!/usr/bin/env bash

if [[ $# -ne 2 ]]; then
    echo "Create a thumbnail for the given video from the frame at the given time" >&2
    echo "Usage:   $0 <video-file> <seek-seconds>" >&2
    echo "Example: $0 Media/foo.mp4 7" >&2
    exit 1
fi

video="$1"
seek="$2"
[[ -f "$video" ]] || { echo "Error: not a file: $video" >&2; exit 1; }

dir="$(dirname "$video")"
name="$(basename "${video%.*}")"
mkdir -p "$dir/thumbnails"

# The flags for ffmpeg:
# -y : overwrite existing files
# -ss <n> : seek to n seconds after start
# -i <v> : use v as input file
# -vf scale=<x>:-1 : scale the image to x pixels wide, keep the aspect ratio
# -frames:v 1 : only extract 1 frame
# -c:v libwep : encoding
# -quality <n> : quality setting between 0 / worst and 100 / best
ffmpeg -y -ss "$seek" -i "$video" -vf scale=480:-1 -frames:v 1 -c:v libwebp -quality 90 \
    "$dir/thumbnails/$name.webp"
